{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(shred *)",
      "Bash(srm *)",
      "Bash(trash *)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(xargs rm*)",
      "Bash(git rm *)",
      "Bash(git clean *)",

      "Bash(git commit)",
      "Bash(git commit *)",

      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch * -d *)",
      "Bash(git branch * -D *)",
      "Bash(git branch * --delete *)",

      "Bash(git push)",
      "Bash(git push *)",

      "Bash(git tag)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ],
    "ask": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(grep *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(touch *)"
    ]
  }
}
