{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://galigaribaldi.github.io/Memorandum-tex/schema/v1/index.schema.json",
  "title": "Índice del catálogo de Memorandum-tex (contrato v1)",
  "description": "Ver docs/contrato-plantillas.md §7. Lo genera `inkt index`; las rutas relativas se resuelven contra la URL de este archivo. Los clientes ignoran los campos desconocidos.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "templates", "packs"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "template.schema.json#/definitions/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homepage": { "type": "string", "pattern": "^https://" }
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "category", "language", "license", "latest", "engines", "defaultEngine", "bibliography", "shellEscape", "manifest", "versions", "dist"],
        "properties": {
          "id": { "$ref": "template.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 300 },
          "category": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*$" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "language": { "type": "string" },
          "license": { "type": "string", "minLength": 1 },
          "latest": { "$ref": "template.schema.json#/definitions/semver" },
          "engines": { "type": "array", "minItems": 1, "items": { "$ref": "template.schema.json#/definitions/engine" } },
          "defaultEngine": { "$ref": "template.schema.json#/definitions/engine" },
          "bibliography": { "enum": ["none", "bibtex", "biber"] },
          "shellEscape": { "type": "boolean" },
          "requires": { "type": "object" },
          "manifest": { "$ref": "#/definitions/ref" },
          "versions": { "$ref": "#/definitions/ref" },
          "preview": { "$ref": "#/definitions/ref" },
          "previewPdf": { "$ref": "template.schema.json#/definitions/previewPdf" },
          "dist": { "$ref": "template.schema.json#/definitions/dist" }
        }
      }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "manifest"],
        "properties": {
          "id": { "$ref": "template.schema.json#/definitions/id" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "maxLength": 300 },
          "manifest": { "$ref": "#/definitions/ref" }
        }
      }
    }
  },
  "definitions": {
    "ref": {
      "description": "Ruta relativa (sin '..' ni '/' inicial) o URL https.",
      "type": "string",
      "anyOf": [
        { "pattern": "^https://" },
        { "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[A-Za-z0-9._/-]+$" }
      ]
    }
  }
}
