{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://galigaribaldi.github.io/Memorandum-tex/schema/v1/pack.schema.json",
  "title": "Paquete de plantillas de Memorandum-tex (contrato v1)",
  "description": "Ver docs/contrato-plantillas.md §8. Un paquete no tiene zip propio: se descarga cada plantilla por separado. 'todo' está reservado (lo genera inkt index).",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "description", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "allOf": [
        { "$ref": "template.schema.json#/definitions/id" },
        { "not": { "const": "todo" } }
      ]
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "$ref": "template.schema.json#/definitions/id" },
          "version": { "$ref": "template.schema.json#/definitions/semver" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
