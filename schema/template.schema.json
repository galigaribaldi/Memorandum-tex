{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://galigaribaldi.github.io/Memorandum-tex/schema/v1/template.schema.json",
  "title": "Manifiesto de plantilla de Memorandum-tex (contrato v1)",
  "description": "Ver docs/contrato-plantillas.md §3–§5. La validación que manda es la de `inkt validate`, que añade reglas que este esquema no puede expresar (§12).",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "name", "description", "category", "language", "license", "authors", "entry", "build", "modes"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1, "description": "Versión del contrato." },
    "id": { "$ref": "#/definitions/id" },
    "version": { "$ref": "#/definitions/semver" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Nombre visible." },
    "description": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^\\n\\r]*$" },
    "category": {
      "type": "string",
      "pattern": "^[a-z]+(-[a-z]+)*$",
      "description": "Igual a la carpeta padre. Recomendadas: academico, presentacion, difusion, correspondencia, congresos.",
      "examples": ["academico", "presentacion", "difusion", "correspondencia", "congresos"]
    },
    "tags": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "examples": ["es-MX", "es"] },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+( AND [A-Za-z0-9.+-]+)*$",
      "description": "Expresión SPDX con AND. Cada identificador debe tener su texto en LICENSES/<identificador>.txt. En Memorandum-tex las plantillas incluyen MIT-0.",
      "examples": ["MIT-0", "MIT-0 AND LicenseRef-isprs"]
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "email": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "entry": { "type": "string", "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.tex$", "default": "main.tex" },
    "build": {
      "type": "object",
      "required": ["engines", "defaultEngine", "bibliography"],
      "properties": {
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/engine" }
        },
        "defaultEngine": { "$ref": "#/definitions/engine" },
        "bibliography": { "enum": ["none", "bibtex", "biber"], "default": "bibtex" },
        "shellEscape": {
          "const": false,
          "default": false,
          "description": "En v1 debe ser false: --shell-escape permite que un .tex ejecute comandos del sistema y los clientes bloquean la plantilla (contrato §3.1)."
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "creativeInk": { "type": "string", "pattern": "^>=(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "texLive": { "type": "integer", "minimum": 2020, "maximum": 2100 },
        "packages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } }
      },
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+(/[a-z0-9-]+)*$" },
      "examples": [["motor", "base", "paletas", "comandos/academico", "instituciones/unam-fes-acatlan"]]
    },
    "parameters": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/definitions/parameter" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "completo" },
      "items": { "enum": ["completo", "rapido", "borrador", "capitulo"] }
    },
    "preview": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.png$" },
    "dist": { "$ref": "#/definitions/dist" }
  },
  "definitions": {
    "id": { "type": "string", "minLength": 2, "maxLength": 40, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "engine": { "enum": ["pdflatex", "xelatex", "lualatex"] },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "dist": {
      "type": "object",
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 209715200 },
        "publishedAt": { "type": "string", "format": "date-time" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["key", "macro", "type", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9]{0,39}$" },
        "macro": { "type": "string", "pattern": "^(?![Ii]nk)[A-Za-z]{1,40}$" },
        "type": { "enum": ["string", "boolean", "enum", "date", "list"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "group": { "type": "string", "maxLength": 40 },
        "required": { "type": "boolean", "default": false },
        "default": {},
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxItems": { "type": "integer", "minimum": 1, "maximum": 50 },
        "fromProjectName": { "type": "boolean" },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,40}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "default": { "type": "string" } }, "not": { "anyOf": [{ "required": ["values"] }, { "required": ["maxItems"] }] } }
        },
        {
          "if": { "properties": { "type": { "const": "boolean" } } },
          "then": {
            "required": ["default"],
            "properties": { "default": { "type": "boolean" } },
            "not": { "anyOf": [{ "required": ["values"] }, { "required": ["maxLength"] }, { "required": ["maxItems"] }, { "required": ["fromProjectName"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": {
            "required": ["values", "default"],
            "properties": { "default": { "type": "string" } },
            "not": { "anyOf": [{ "required": ["maxLength"] }, { "required": ["maxItems"] }, { "required": ["fromProjectName"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "date" } } },
          "then": {
            "properties": { "default": { "anyOf": [{ "const": "today" }, { "$ref": "#/definitions/isoDate" }] } },
            "not": { "anyOf": [{ "required": ["values"] }, { "required": ["maxLength"] }, { "required": ["maxItems"] }, { "required": ["fromProjectName"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": {
            "properties": { "default": { "type": "array", "items": { "type": "string" } } },
            "not": { "anyOf": [{ "required": ["values"] }, { "required": ["fromProjectName"] }] }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
